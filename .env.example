# Copia este archivo como .env (no se sube al repositorio) o define las
# variables en el panel de Render. Todas son opcionales en local.

# Puerto (Render lo define solo). Por defecto 8895.
PORT=8895

# Usuario de la intranet. Se aplican en CADA arranque.
# Sin ADMIN_PASSWORD el primer arranque crea admin/admin: SOLO para local.
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-clave

# Firma de las sesiones (12 h). Sin ella, reiniciar cierra todas las sesiones.
SESSION_SECRET=una-cadena-larga-y-aleatoria

# Ruta de la base SQLite. En Render apunta a un disco persistente, p. ej.
# /var/data/data.db (si no, la base se borra en cada despliegue).
DB_PATH=

# URL pública final (activa canonical y el sitemap con el dominio correcto).
SITE_URL=

# Google Calendar (opcional). Ver README → Google Calendar.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
